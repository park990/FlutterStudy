# ⚙️ Dart / Flutter Build Artifacts and Cache
# 빌드 시 생성되는 모든 파일이 들어있는 디렉토리
/build
# Dart/Flutter 툴링이 사용하는 캐시 및 임시 파일 디렉토리
.dart_tool/
# 패키지 관리 정보 파일 (대부분 pubspec.lock에 의존하여 다시 생성 가능)
.packages
.flutter-plugins
.flutter-plugins-dependencies

# 💻 Platform-specific Temporary Files
# Android 빌드 시 생성되는 임시/로컬 설정
/android/local.properties
# iOS Pods (설치된 라이브러리) - 'pod install'로 다시 생성됨
/ios/Pods
/ios/.symlinks

# 🍎 macOS Temporary Files
# macOS 파인더 정보 저장 파일 (목록에 포함되어 있어 명시적으로 추가)
.DS_Store

# 🧩 Auto-Generated Files
# 코드 생성(Code Generation) 패키지 (Isar, Freezed 등)로 인해 생성된 파일
# 이 파일을 Git에 포함시키는 경우도 많지만, 여기서는 무시 목록에 추가합니다.
# 만약 팀 규약상 포함해야 한다면 아래 줄을 삭제하세요.
/lib/**/*.g.dart 
/lib/**/*.freezed.dart

# 🛠️ IDE Files
# IntelliJ / Android Studio 설정 파일
.idea/
# VS Code 설정 파일
.vscode/

# 📜 기타
# 목록에 포함되어 있지만, 일반적으로 Git에 포함시키지 않는 메타데이터
.metadata